const field=(label,name,value='',type='text',required=false,extra='')=>`<div class="field ${extra}"><label for="f_${name}">${esc(label)}${required?' *':''}</label><input class="control" id="f_${name}" name="${name}" type="${type}" value="${esc(value)}" ${required?'required':''}></div>`;
const select=(label,name,values,selected='',required=false,placeholder='Pilih...')=>`<div class="field"><label for="f_${name}">${esc(label)}${required?' *':''}</label><select class="control" id="f_${name}" name="${name}" ${required?'required':''}>${opt(values,selected,placeholder)}</select></div>`;
const textarea=(label,name,value)=>`<div class="field span2"><label for="f_${name}">${esc(label)}</label><textarea class="control" id="f_${name}" name="${name}" rows="3">${esc(value||'')}</textarea></div>`;
const card=(title,body,small='')=>`<section class="card"><div class="card-head"><h2>${title}</h2>${small?`<span class="small">${small}</span>`:''}</div>${body}</section>`;
const sectionTitle=(title,sub,actions='')=>`<div class="page-head"><div><h1>${title}</h1><p>${sub}</p></div><div class="filters">${actions}</div></div>`;
const stat=(label,num,detail)=>`<div class="stat"><div class="label">${label}</div><div class="number">${num}</div><div class="muted small">${detail}</div></div>`;
const rowEmpty=cols=>`<tr><td colspan="${cols}" class="empty">Tidak ada data pada cakupan ini.</td></tr>`;
const table=(headers,rows)=>`<div class="table-wrap"><table><thead><tr>${headers.map(x=>`<th>${x}</th>`).join('')}</tr></thead><tbody>${rows.length?rows.join(''):rowEmpty(headers.length)}</tbody></table></div>`;
function toast(message){S.toast=message;render();setTimeout(()=>{if(S.toast===message){S.toast='';let e=$('.toast');if(e)e.remove()}},3500)}
function notify(message){toast(message)}
function render(){const root=byId('root');root.innerHTML=S.screen!=='app'?login():app();bind();}
function login(){let isOtp=S.screen==='otp';return `<div class="login-bg"><div class="login-card"><div class="logo">M</div><div class="eyebrow" style="margin-top:24px">MODENA After Sales Portal</div><h1 class="h1">${isOtp?'Verify your account':'Service Center Hub'}</h1><p class="muted" style="margin:0 0 25px">${isOtp?'Masukkan kode OTP untuk melanjutkan.':'Visit Management & Indoor Service dalam satu workspace.'}</p>${isOtp?`<div class="hint">Preview mode: kode OTP <strong style="letter-spacing:3px;font-size:18px;color:#284cca">123456</strong><br>Kode ini hanya simulasi, tidak dikirim melalui email dan tidak memberikan keamanan autentikasi yang nyata.</div><form id="otpForm" style="margin-top:19px">${field('One-Time Password','otp','','text',true)}<button class="btn primary block" style="margin-top:16px">Verify & Sign In →</button></form><button class="btn ghost block" id="backLogin" style="margin-top:9px">← Ganti akun</button>`:`<form id="loginForm">${field('Email address','email',S.pendingEmail,'email',true)}<button class="btn primary block" style="margin-top:16px">Continue with OTP →</button></form><div class="separator"></div><div class="eyebrow">Demo Accounts</div><div class="account-list">${db.users.filter(u=>u.active).slice(0,8).map(u=>`<button type="button" class="account" data-demo-email="${esc(u.email)}"><span><strong>${esc(u.name)}</strong><br><span class="small muted">${esc(u.email)}</span></span><span class="badge blue">${esc(roleName(u.role))}</span></button>`).join('')}</div>`}<p class="muted small" style="margin-top:20px;text-align:center">Standalone HTML Preview · Data disimpan hanya di browser ini</p></div></div>`}
const navs=[['overview','▦','Overview'],['announcements','◈','Announcements'],['visits','▤','Visit Records'],['visitNew','＋','Register Visit'],['indoor','▣','Indoor Service'],['indoorNew','＋','Register Indoor'],['analytics','▥','Analytics'],['catalog','◇','Model Catalog']];
function app(){let nav=[...navs];if(superAdmin())nav.push(['masters','⚙','Master Data'],['users','♙','User Accounts']);const titles={announcements:'Announcements',overview:'Overview',visits:'Visit Records',visitNew:'Visit Registration',indoor:'Indoor Service Records',indoorNew:'Indoor Job Registration',analytics:'Analytics',catalog:'Model Catalog',masters:'Master Data',users:'User Management'};return `<div class="app"><aside class="sidebar"><div class="brand"><div class="logo">M</div><div><strong>MODENA After Sales</strong><span>Service Center Hub</span></div></div><div class="nav-label">Operations</div>${nav.map(([id,ico,name])=>`<button class="nav ${S.view===id?'active':''}" data-nav="${id}" title="${name}"><span class="ico">${ico}</span><span>${name}</span></button>`).join('')}<div class="sidebar-foot"><div class="eyebrow">Signed in as</div><strong>${esc(current().name)}</strong><div class="small muted">${esc(roleName(current().role))}</div><button class="btn sm" style="margin-top:12px;width:100%" data-logout>Sign out</button></div></aside><div class="main"><header class="topbar"><div><h3>${titles[S.view]||'Service Center Hub'}</h3><div class="sub">MODENA After Sales Portal / Service Center Hub</div></div><div class="account-menu"><span class="badge blue role">${roleName(current().role)}</span><button class="btn sm" data-switch title="Switch demo account">◉ ${esc(current().name)}</button></div></header><main class="content">${view()}</main></div></div>${S.modal?renderModal():''}${S.toast?`<div class="toast">${esc(S.toast)}</div>`:''}`}
function scopeFilters(){const ac=allowedCenters();return `<select class="control" id="scopeCenter" aria-label="Filter service center"><option value="all">All Accessible Centers</option>${opt(ac,S.centerFilter)}</select>`}
function view(){switch(S.view){case'overview':return overview();case'announcements':return announcementsPage();case'visits':return visitsList();case'visitNew':return visitForm();case'indoor':return indoorList();case'indoorNew':return indoorForm();case'analytics':return analytics();case'catalog':return modelCatalog();case'masters':return superAdmin()?masters():overview();case'users':return superAdmin()?usersList():overview();default:return overview()}}
function overview(){let v=filtered(db.visits),i=filtered(db.indoor),openV=v.filter(x=>x.status!=='Closed'&&x.status!=='Cancelled'),openI=i.filter(x=>!['Completed','Cancelled'].includes(x.status));return `${sectionTitle('Service Center Overview','Ringkasan operasional visit dan indoor sesuai cakupan akun.',scopeFilters())}<div class="stats">${stat('Total Visits',v.length,'Kunjungan tercatat')}${stat('Open Visits',openV.length,'Butuh tindak lanjut')}${stat('Indoor Jobs',i.length,'Pekerjaan indoor tercatat')}${stat('Active Indoor',openI.length,'Belum completed')}</div><div class="cols2">${card('Visit Purpose',`<div class="card-body">${bars(v,'purpose')}</div>`)}${card('Indoor Status',`<div class="card-body">${bars(i,'status')}</div>`)}</div>${announcementOverview()}<div class="notice">Storage mode: browser localStorage (preview). Untuk Apps Script nanti, Google Sheets hanya dipakai sebagai penyimpanan ringkas dan arsip/batch, bukan dibaca ulang setiap klik. Master, coverage, dan announcements dapat di-cache; transaksi dilakukan via server dengan kontrol akses.</div>${card('Recent Visits',table(['Visit ID','Date','Customer','Center','Purpose','Status'],v.slice().sort((a,b)=>b.date.localeCompare(a.date)).slice(0,6).map(x=>`<tr><td><strong>${esc(x.id)}</strong></td><td>${dt(x.date)}</td><td>${esc(x.customer)}</td><td>${esc(centerName(x.centerId))}</td><td>${esc(x.purpose)}</td><td>${badge(x.status)}</td></tr>`)))}${card('Indoor Workflow',`<div class="card-body"><div class="progress"><span class="step">Received</span><span class="step">Inspection</span><span class="step">Under Repair</span><span class="step">Quality Check</span><span class="step">Ready for Pickup</span><span class="step">Completed</span></div><p class="muted small">Setiap indoor job memiliki referensi visit (opsional), nomor RON, teknisi, finding, tindakan, QC, dan tanggal handover. Alur bisa diatur melalui master data pada implementasi lanjutan.</p></div>`)}`}
function bars(arr,key){let map={};for(const x of arr)map[x[key]||'Unknown']=(map[x[key]||'Unknown']||0)+1;let pairs=Object.entries(map).sort((a,b)=>b[1]-a[1]);let max=Math.max(...pairs.map(x=>x[1]),1);return pairs.length?`<div class="bars">${pairs.map(([label,n])=>`<div><div class="bar-line"><span>${esc(label)}</span><strong>${n} <span class="muted">(${(n/arr.length*100).toFixed(0)}%)</span></strong></div><div class="bar-track"><div class="bar-fill" style="width:${n/max*100}%"></div></div></div>`).join('')}</div>`:'<div class="empty">Belum ada data untuk ditampilkan.</div>'}
function visitsList(){let v=filtered(db.visits).slice().sort((a,b)=>b.date.localeCompare(a.date));return `${sectionTitle('Visit Records','Registrasi customer, konsultasi, pengajuan service, dan hasil kunjungan.',`<button class="btn primary" data-nav="visitNew">＋ New Visit</button>`)}<div class="card"><div class="toolbar"><input class="control search" id="search" placeholder="Search customer, RON, model..." value="${esc(S.search)}">${scopeFilters()}</div>${table(['Visit ID','Visit Date','Customer','Service Center','Model','Visit Purpose','RON','Status','Action'],v.map(x=>`<tr><td><strong>${esc(x.id)}</strong></td><td>${dt(x.date)}</td><td><strong>${esc(x.customer)}</strong></td><td>${esc(centerName(x.centerId))}</td><td>${esc(x.model)}</td><td>${esc(x.purpose)}</td><td>${esc(x.ron||'—')}</td><td>${badge(x.status)}</td><td><div class="table-actions"><button class="btn sm" data-detail="visit:${esc(x.id)}">Detail</button><button class="btn sm" data-edit="visit:${esc(x.id)}">Edit</button></div></td></tr>`))}</div>`}
function visitForm(x={}){const centers=allowedCenters().filter(c=>c.active);const cId=x.centerId||(centers.length===1?centers[0].id:'');let edit=!!x.id;return `${sectionTitle(edit?'Edit Visit':'Register New Visit','Record walk-in customer dan tindak lanjutnya.')}${!centers.length?'<div class="notice">Tidak ada Service Center aktif yang terhubung ke akun ini. Hubungi Super Admin.</div>':''}<form id="visitForm" class="card"><div class="card-body"><div class="form-grid"><div class="form-section">Visit Information</div>${field('Visit Date & Time','date',x.date||dateLocal(),'datetime-local',true)}${select('Service Center','centerId',centers,cId,true)}${field('Customer Name','customer',x.customer||'','text',true)}${field('Phone Number','phone',x.phone||'','tel')}${field('Customer Address','address',x.address||'')}${modelInput('Model / Product','model',x.model||'')}${select('Visit Purpose','purpose',db.purposes.filter(p=>p.active).map(p=>p.name),x.purpose||'',true)}${select('Customer Source','source',db.sources.filter(z=>z.active).map(z=>z.name),x.source||'Guest Biasa')}${textarea('Complaint / Need','complaint',x.complaint)}<div class="form-section">Follow-up & Case Tracking</div>${field('RON Number (optional)','ron',x.ron||'')}${select('Visit Status','status',['Open','In Progress','Closed','Cancelled'],x.status||'Open',true)}${field('PIC / Frontdesk','pic',x.pic||current().name)}${textarea('Result / Follow-up Notes','result',x.result)}<div class="span2 hint">Visit ID dibuat otomatis. RON tidak wajib untuk konsultasi. Nomor RON di preview hanya teks; integrasi dan validasinya dilakukan saat Apps Script terhubung ke data GCCS.</div></div><div class="form-actions"><button type="button" class="btn" data-nav="visits">Cancel</button><button class="btn primary" ${!centers.length?'disabled':''}>${edit?'Save Changes':'Register Visit'}</button></div></div></form>`}
function indoorList(){let d=filtered(db.indoor).slice().sort((a,b)=>b.received.localeCompare(a.received));return `${sectionTitle('Indoor Service Records','Tracking penerimaan, inspeksi, repair, quality check hingga handover.',`<button class="btn primary" data-nav="indoorNew">＋ New Indoor Job</button>`)}<div class="card"><div class="toolbar"><input class="control search" id="search" placeholder="Search job, RON, customer, technician..." value="${esc(S.search)}">${scopeFilters()}</div>${table(['Job ID','Received','Customer / Model','Service Center','Type','Technician','Target','Status','Action'],d.map(x=>`<tr><td><strong>${esc(x.id)}</strong><div class="muted tiny">${esc(x.ron||'No RON')}</div></td><td>${dt(x.received)}</td><td><strong>${esc(x.customer)}</strong><div class="muted">${esc(x.model)}</div></td><td>${esc(centerName(x.centerId))}</td><td>${esc(x.type)}</td><td>${esc(x.technician||'—')}</td><td>${dt(x.target)}</td><td>${badge(x.status)}</td><td><div class="table-actions"><button class="btn sm" data-detail="indoor:${esc(x.id)}">Detail</button><button class="btn sm" data-edit="indoor:${esc(x.id)}">Edit</button></div></td></tr>`))}</div>`}
function indoorForm(x={}){const cs=allowedCenters().filter(c=>c.active);const cid=x.centerId||(cs.length===1?cs[0].id:'');let related=db.visits.filter(v=>canCenter(v.centerId)&&(!cid||v.centerId===cid));let edit=!!x.id;return `${sectionTitle(edit?'Edit Indoor Job':'Register Indoor Job','Catat setiap tahap pekerjaan indoor dengan status dan hasil pemeriksaan.')}${!cs.length?'<div class="notice">Tidak ada Service Center aktif pada akun Anda.</div>':''}<form id="indoorForm" class="card"><div class="card-body"><div class="form-grid"><div class="form-section">Job Identification</div>${select('Service Center','centerId',cs,cid,true)}${select('Related Visit ID (optional)','visitId',related.map(v=>({id:v.id,name:v.id+' · '+v.customer+' · '+v.model})),x.visitId||'',false,'No related visit')}${field('Customer Name','customer',x.customer||'','text',true)}${modelInput('Product / Model','model',x.model||'')}${field('RON Number','ron',x.ron||'')}${select('Indoor Job Type','type',db.indoorTypes.filter(i=>i.active).map(i=>i.name),x.type||'',true)}${field('Received Date & Time','received',x.received||dateLocal(),'datetime-local',true)}${field('Target Completion','target',x.target||'','date')}${field('Assigned Technician','technician',x.technician||'')}${select('Indoor Status','status',['Received','Inspection','Under Repair','Waiting Part','Quality Check','Ready for Pickup','Completed','Cancelled'],x.status||'Received',true)}<div class="form-section">Engineering & Quality Records</div>${textarea('Inspection Findings','finding',x.finding)}${textarea('Repair Action / Treatment','action',x.action)}${select('QC Status','qc',['Not Checked','Passed','Failed'],x.qc||'Not Checked',true)}${field('Handover Date','handover',x.handover||'','date')}<div class="span2 hint">Status Completed tidak bisa dipilih sebelum QC dinyatakan Passed. Validasi ini diterapkan juga saat penyimpanan, bukan hanya pada tampilan.</div></div><div class="form-actions"><button type="button" class="btn" data-nav="indoor">Cancel</button><button class="btn primary" ${!cs.length?'disabled':''}>${edit?'Save Changes':'Create Indoor Job'}</button></div></div></form>`}
function analytics(){let v=filtered(db.visits),i=filtered(db.indoor),cs=allowedCenters().filter(c=>S.centerFilter==='all'||c.id===S.centerFilter),info=cs.map(c=>{let a=v.filter(x=>x.centerId===c.id),b=i.filter(x=>x.centerId===c.id);return{c,visits:a.length,indoor:b.length,open:a.filter(x=>x.status!=='Closed'&&x.status!=='Cancelled').length,qc:b.filter(x=>x.qc==='Passed').length}});return `${sectionTitle('Service Operation Analytics','Perbandingan visit volume, indoor job, dan progress antar-service center.',scopeFilters())}<div class="stats">${stat('Visit Volume',v.length,'Dalam filter aktif')}${stat('Service Requests',v.filter(x=>x.purpose==='Request Service').length,'Kunjungan request service')}${stat('Indoor Job Volume',i.length,'Pekerjaan indoor')}${stat('QC Passed',i.filter(x=>x.qc==='Passed').length,'QC passed tercatat')}</div><div class="cols2">${card('Visits by Center',`<div class="card-body">${bars(v.map(x=>({...x,branch:centerName(x.centerId)})),'branch')}</div>`)}${card('Indoor Job Types',`<div class="card-body">${bars(i,'type')}</div>`)}</div>${card('Service Center Performance (Preview)',table(['Service Center','Type','Area','Visits','Open Visits','Indoor Jobs','QC Passed'],info.map(r=>`<tr><td><strong>${esc(r.c.name)}</strong></td><td>${badge(r.c.type)}</td><td>${esc(r.c.area)}</td><td>${r.visits}</td><td>${r.open}</td><td>${r.indoor}</td><td>${r.qc}</td></tr>`)))}<div class="notice">Metrik demo menggunakan jumlah record, bukan KPI historis aktual. Conversion, RTAT, handling time, turnaround dan aging membutuhkan definisi tanggal/status dan histori terverifikasi sebelum diaktifkan untuk laporan operasional.</div>`}

const safeLink=url=>{try{let u=new URL(url);return ['https:','http:'].includes(u.protocol)?u.href:''}catch{return''}};
const announcementVisible=a=>{if(a.status!=='Published')return false;if(superAdmin())return true;if(a.audience==='All')return true;if(a.audience.startsWith('Area:'))return allowedCenters().some(c=>c.area===a.audience.slice(5));if(a.audience.startsWith('Center:'))return canCenter(a.audience.slice(7));return false};
function shownAnnouncements(){return db.announcements.filter(announcementVisible).sort((a,b)=>(b.priority==='Pinned')-(a.priority==='Pinned')||b.created.localeCompare(a.created))}
function announcementBox(a,admin=false){let url=safeLink(a.link||'');return `<article class="announcement-item"><div class="between"><div class="row"><span class="badge">${esc(a.category||'General')}</span>${a.priority==='Pinned'?'<span class="badge blue">Pinned</span>':''}${admin?badge(a.status):''}</div><span class="muted tiny">${dt(a.created)}</span></div><h3 style="font-size:14px;margin:9px 0 6px">${esc(a.title)}</h3><p class="muted" style="margin:0;white-space:pre-wrap;font-size:12px;line-height:1.65">${esc(a.body)}</p><div class="between" style="margin-top:12px"><div>${url?`<a class="btn sm" href="${esc(url)}" target="_blank" rel="noopener noreferrer">${esc(a.linkText||'Open Link')} ↗</a>`:''}</div>${admin?`<button class="btn sm" data-ann-edit="${esc(a.id)}">Edit Announcement</button>`:''}</div></article>`}
function announcementOverview(){let a=shownAnnouncements().slice(0,5);return card('Latest Announcements',`<div class="card-body"><div class="between" style="margin-bottom:12px"><span class="small muted">5 pengumuman prioritas terbaru. Tanpa running ticker.</span><button class="btn sm" data-nav="announcements">View All</button></div><div class="ann-grid">${a.length?a.map(x=>announcementBox(x)).join(''):'<div class="empty">Belum ada pengumuman untuk cakupan akun ini.</div>'}</div></div>`)}
function announcementsPage(){let isAdmin=superAdmin(),items=isAdmin?db.announcements.slice().sort((a,b)=>(b.priority==='Pinned')-(a.priority==='Pinned')||b.created.localeCompare(a.created)):shownAnnouncements();return `${sectionTitle('Announcements','Informasi dan pemberitahuan operasional Service Center Hub.',isAdmin?'<button class="btn primary" data-ann-add>＋ New Announcement</button>':'')}<div class="notice">${isAdmin?'Super Admin dapat membuat, mengedit, mem-publish, dan mengarsipkan pengumuman.':'Pengumuman disesuaikan dengan cakupan area atau service center akun Anda.'} Link pada announcement dapat dibuka sebagai tombol.</div><div class="ann-grid">${items.length?items.map(a=>announcementBox(a,isAdmin)).join(''):'<div class="empty">Belum ada announcement.</div>'}</div>`}
function announcementModal(){let x=db.announcements.find(a=>a.id===S.editId)||{},edit=!!x.id;let audiences=[{id:'All',name:'All Users'},...db.areas.map(a=>({id:'Area:'+a.name,name:'Area - '+a.name})),...db.centers.map(c=>({id:'Center:'+c.id,name:'Center - '+c.name}))];return modal(edit?'Edit Announcement':'Create Announcement',`<form id="announcementForm"><div class="form-grid">${field('Title','title',x.title||'','text',true)}${select('Category','category',['Information','Operational','Indoor Service','Visit Management','Urgent','Other'],x.category||'Information',true)}${textarea('Announcement Content','body',x.body||'')}${select('Audience','audience',audiences,x.audience||'All',true)}${select('Priority','priority',['Normal','Pinned'],x.priority||'Normal',true)}${select('Status','status',['Draft','Published','Archived'],x.status||'Draft',true)}${field('Link URL (optional)','link',x.link||'','url')}${field('Link Button Text (optional)','linkText',x.linkText||'')}<div class="span2 hint">Maksimal 5 pengumuman prioritas terbaru ditampilkan di Overview. Jika URL diisi, tautan ditampilkan sebagai tombol. Tidak ada marquee atau running text.</div></div><div class="form-actions"><button type="button" class="btn" id="cancelModal">Cancel</button><button class="btn primary">${edit?'Save Changes':'Create Announcement'}</button></div></form>`)}
function onSubmitAnnouncement(form){if(!superAdmin())return;let v=formObj(form);if(!v.title||!v.body)return notify('Judul dan isi pengumuman wajib diisi.');if(v.link&&!safeLink(v.link))return notify('URL harus menggunakan http atau https yang valid.');let x=S.editId?db.announcements.find(a=>a.id===S.editId):null;let id=x?.id||'ANN-'+String(Math.max(0,...db.announcements.map(a=>Number(a.id.replace(/\D/g,''))||0))+1).padStart(3,'0');let record={id,...v,created:x?.created||dateLocal()};if(x)Object.assign(x,record);else db.announcements.push(record);save();S.modal=null;S.editId=null;S.view='announcements';toast('Announcement berhasil disimpan.');}
const masterTabs=[['centers','Service Centers'],['types','SC Types'],['areas','Areas'],['purposes','Visit Purposes'],['indoorTypes','Indoor Types'],['models','Product Models'],['sources','Customer Sources']];
function modelInput(label,name,value){return `<div class="field"><label for="f_${name}">${esc(label)} *</label><input class="control" id="f_${name}" name="${name}" list="model-options-${name}" value="${esc(value)}" required placeholder="Ketik atau pilih model"><datalist id="model-options-${name}">${db.models.filter(m=>m.active).map(m=>`<option value="${esc(m.name)}"></option>`).join('')}</datalist><div class="muted tiny" style="margin-top:5px">Model baru tetap bisa diketik. Sistem otomatis mengirim usulan ke Super Admin.</div></div>`}
function queueModel(name,creator){name=String(name||'').trim();if(!name)return;const exists=db.models.some(m=>m.name.toLowerCase()===name.toLowerCase());const pending=db.modelRequests.some(r=>r.name.toLowerCase()===name.toLowerCase()&&r.status==='Pending');if(!exists&&!pending)db.modelRequests.push({id:'MR-'+(db.modelRequests.length+1).toString().padStart(4,'0'),name,creatorId:creator,created:dateLocal(),status:'Pending',reviewedBy:'',category:''})}
function modelCatalog(){let pending=db.modelRequests.filter(r=>r.status==='Pending'),catalog=db.models.slice().sort((a,b)=>a.name.localeCompare(b.name));return `${sectionTitle('Model Catalog','Referensi produk bersama. Cabang boleh mengusulkan model; Super Admin menyetujui master.',`<button class="btn primary" data-model-suggest>＋ Suggest Model</button>`)}<div class="stats">${stat('Approved Models',catalog.length,'Master model pusat')}${stat('Pending Requests',pending.length,'Menunggu Super Admin')}${stat('Active Models',catalog.filter(x=>x.active).length,'Model dapat dipilih')}${stat('Data Storage','Local','Preview tanpa Google Sheets')}</div>${superAdmin()?card('Pending Approval',table(['Proposed Model','Submitted By','Date','Status','Review'],pending.map(x=>`<tr><td><strong>${esc(x.name)}</strong></td><td>${esc(db.users.find(u=>u.id===x.creatorId)?.name||'Guest')}</td><td>${dt(x.created)}</td><td>${badge(x.status)}</td><td><div class="table-actions"><button class="btn sm primary" data-model-approve="${esc(x.id)}">Approve</button><button class="btn sm" data-model-reject="${esc(x.id)}">Reject</button></div></td></tr>`))):'<div class="notice">Model yang belum tersedia dapat diusulkan di sini atau diketik langsung saat registrasi. Usulan baru berstatus Pending hingga diperiksa Super Admin.</div>'}${card('Approved Product Models',table(['Model Name','Category','Status'],catalog.map(m=>`<tr><td><strong>${esc(m.name)}</strong></td><td>${esc(m.category||'Not set')}</td><td>${badge(m.active?'Active':'Inactive')}</td></tr>`)))}${card('My / All Model Requests',table(['Model','Submitted By','Status'],db.modelRequests.filter(r=>superAdmin()||r.creatorId===current().id).map(r=>`<tr><td>${esc(r.name)}</td><td>${esc(db.users.find(u=>u.id===r.creatorId)?.name||'Guest')}</td><td>${badge(r.status)}</td></tr>`)))}`}
function modelSuggestModal(){return modal('Suggest New Product Model',`<form id="modelSuggestForm"><div class="form-grid">${field('Model Name','name','','text',true)}${field('Category (optional)','category')}</div><div class="hint" style="margin-top:12px">Usulan model tidak langsung masuk master; Super Admin melakukan validasi terlebih dahulu.</div><div class="form-actions"><button type="button" class="btn" id="cancelModal">Cancel</button><button class="btn primary">Submit Suggestion</button></div></form>`)}
function masters(){let tab=S.tab,items=db[tab]||[],heads,rows;if(tab==='centers'){heads=['Center','Type','Area','Status','Action'];rows=items.map(x=>`<tr><td><strong>${esc(x.name)}</strong><div class="muted tiny">${esc(x.id)}</div></td><td>${esc(x.type)}</td><td>${esc(x.area)}</td><td>${badge(x.active?'Active':'Inactive')}</td><td><button class="btn sm" data-master-edit="${esc(x.id)}">Edit</button></td></tr>`)}else{heads=['Name','Description / ID','Status','Action'];rows=items.map(x=>`<tr><td><strong>${esc(x.name)}</strong></td><td>${esc(x.description||x.category||x.id)}</td><td>${badge(x.active===false?'Inactive':'Active')}</td><td><button class="btn sm" data-master-edit="${esc(x.id)}">Edit</button></td></tr>`)}return `${sectionTitle('Master Data','Kelola referensi tanpa mengubah kode aplikasi.',`<button class="btn primary" data-add-master>＋ Add New</button>`)}<div class="card"><div class="tabs">${masterTabs.map(([id,n])=>`<button class="tab ${tab===id?'active':''}" data-master-tab="${id}">${n}</button>`).join('')}</div>${table(heads,rows)}</div><div class="notice">Hanya Super Admin yang dapat mengubah master data. Tipe Service Center baru akan otomatis tersedia pada form Service Center. Master status aktif/nonaktif mencegah entri baru tanpa menghapus histori.</div>`}
function usersList(){return `${sectionTitle('User Accounts','Role-based access untuk Super Admin, Service Operation Lead, dan Branch User.',`<button class="btn primary" data-add-user>＋ Add Account</button>`)}<div class="card">${table(['User','Email','Role','Scope','Status','Action'],db.users.map(u=>`<tr><td><strong>${esc(u.name)}</strong></td><td>${esc(u.email)}</td><td>${badge(roleName(u.role))}</td><td>${u.role==='super'?'All Centers':u.role==='lead'?esc([...(u.areas||[]).map(x=>'Area: '+x),...(u.centers||[]).map(x=>'Center: '+centerName(x))].join(' · ')||'No Scope'):esc(u.centers.map(centerName).join(', ')||'No Center')}</td><td>${badge(u.active?'Active':'Inactive')}</td><td><button class="btn sm" data-user-edit="${esc(u.id)}">Edit</button></td></tr>`))}</div><div class="notice">Super Admin dapat memilih satu atau lebih area dan cabang khusus untuk masing-masing Lead; Branch User berdasarkan Service Center yang ditugaskan. Di backend Apps Script nanti, pengecekan scope harus dilakukan ulang pada setiap aksi server, tidak cukup hanya menyembunyikan menu.</div>`}
function modal(title,body){return `<div class="overlay" id="overlay"><div class="modal" role="dialog" aria-modal="true" aria-label="${esc(title)}"><div class="modal-head"><h2>${esc(title)}</h2><button class="btn sm" id="closeModal">✕</button></div><div class="modal-body">${body}</div></div></div>`}
function kv(label,value){return `<div class="kv"><span>${label}</span><strong>${esc(value||'—')}</strong></div>`}
function renderModal(){if(S.modal==='detail'){let type=S.detailType,x=db[type==='visit'?'visits':'indoor'].find(r=>r.id===S.detailId);if(!x||!canCenter(x.centerId))return'';return modal(type==='visit'?'Visit Detail '+x.id:'Indoor Detail '+x.id,`<div class="badge blue">${esc(centerName(x.centerId))}</div><div style="margin:12px 0">${kv('Customer',x.customer)}${kv('Model',x.model)}${kv('RON',x.ron)}${kv('Status',x.status)}${type==='visit'?kv('Visit Date',dt(x.date))+kv('Purpose',x.purpose)+kv('Complaint',x.complaint)+kv('Follow-up',x.result):kv('Received',dt(x.received))+kv('Technician',x.technician)+kv('Finding',x.finding)+kv('Repair Action',x.action)+kv('QC',x.qc)+kv('Target',dt(x.target))+kv('Handover',dt(x.handover))}</div><div class="form-actions"><button class="btn" id="closeDetail">Close</button><button class="btn primary" data-edit="${type}:${esc(x.id)}">Edit Record</button></div>`)}if(S.modal==='modelSuggest')return modelSuggestModal();if(S.modal==='announcement')return announcementModal();if(S.modal==='master')return masterModal();if(S.modal==='user')return userModal();return''}
function masterModal(){let type=S.tab,items=db[type],x=items.find(v=>v.id===S.editId)||{},edit=!!x.id;let body=`<form id="masterForm"><div class="form-grid">${field('Name','name',x.name||'','text',true)}${type==='centers'?select('SC Type','type',db.types.filter(t=>t.active||t.name===x.type).map(t=>t.name),x.type||'',true)+select('Area','area',db.areas.map(t=>t.name),x.area||'',true):type==='types'?field('Description','description',x.description||''):type==='models'?field('Product Category','category',x.category||''):''}<div class="field"><label>Status</label><select class="control" name="active">${opt([{id:'true',name:'Active'},{id:'false',name:'Inactive'}],String(x.active!==false))}</select></div></div><div class="form-actions"><button type="button" class="btn" id="cancelModal">Cancel</button><button class="btn primary">${edit?'Save Changes':'Add '+type}</button></div></form>`;return modal((edit?'Edit ':'Add ')+masterTabs.find(z=>z[0]===type)[1],body)}
function userModal(){let x=db.users.find(v=>v.id===S.editId)||{},edit=!!x.id;let centers=db.centers,areas=db.areas;let body=`<form id="userForm"><div class="form-grid">${field('Full Name','name',x.name||'','text',true)}${field('Email Address','email',x.email||'','email',true)}${select('Role','role',[{id:'super',name:'Super Admin'},{id:'lead',name:'Service Operation Lead'},{id:'branch',name:'Branch User'}],x.role||'branch',true)}<div class="field"><label>Status</label><select class="control" name="active">${opt([{id:'true',name:'Active'},{id:'false',name:'Inactive'}],String(x.active!==false))}</select></div><div class="field"><label>Assigned Areas (Lead)</label><select class="control" name="areas" multiple size="${Math.min(5,Math.max(3,areas.length))}">${areas.map(a=>`<option value="${esc(a.name)}" ${(x.areas||[]).includes(a.name)?'selected':''}>${esc(a.name)}</option>`).join('')}</select><div class="muted tiny">Ctrl/Cmd + klik untuk multi-select</div></div><div class="field"><label>Assigned Service Centers (Lead / Branch)</label><select class="control" name="centers" multiple size="${Math.min(6,Math.max(3,centers.length))}">${centers.map(c=>`<option value="${esc(c.id)}" ${(x.centers||[]).includes(c.id)?'selected':''}>${esc(c.name)}</option>`).join('')}</select><div class="muted tiny">Akses Branch User hanya cabang terpilih</div></div></div><div class="form-actions"><button type="button" class="btn" id="cancelModal">Cancel</button><button class="btn primary">${edit?'Save Account':'Create Account'}</button></div></form>`;return modal(edit?'Edit User Account':'New User Account',body)}
function formObj(form){let o={};for(const el of form.elements){if(!el.name||el.disabled)continue;if(el.multiple)o[el.name]=Array.from(el.selectedOptions).map(x=>x.value);else o[el.name]=el.value.trim()}return o}
function formId(arr,prefix){return prefix+'-'+String(Math.max(1000,...arr.map(x=>Number((x.id.match(/(\d+)$/)||[])[1])||0))+1).padStart(4,'0')}
function onSubmitVisit(form){let v=formObj(form);if(!canCenter(v.centerId))return notify('Akses service center ditolak.');if(!v.customer||!v.model||!v.date||!v.purpose)return notify('Isi kolom wajib.');let x=S.editId?db.visits.find(z=>z.id===S.editId):null;if(S.editId&&!x)return notify('Record tidak ditemukan.');let id=x?.id||formId(db.visits,'VIS');let next={id,...v};queueModel(v.model,current().id);if(x)Object.assign(x,next);else db.visits.push(next);save();S.editId=null;S.search='';S.view='visits';toast('Visit '+id+' berhasil disimpan.');}
function onSubmitIndoor(form){let v=formObj(form);if(!canCenter(v.centerId))return notify('Akses service center ditolak.');if(!v.customer||!v.model||!v.received||!v.type)return notify('Isi kolom wajib.');if(v.visitId){let related=db.visits.find(x=>x.id===v.visitId);if(!related||!canCenter(related.centerId)||related.centerId!==v.centerId)return notify('Related Visit harus berasal dari Service Center yang sama.')}if(v.status==='Completed'&&v.qc!=='Passed')return notify('Tidak dapat Completed sebelum QC Passed.');let x=S.editId?db.indoor.find(z=>z.id===S.editId):null;if(S.editId&&!x)return notify('Job tidak ditemukan.');let id=x?.id||formId(db.indoor,'IND');let next={id,...v};queueModel(v.model,current().id);if(x)Object.assign(x,next);else db.indoor.push(next);save();S.editId=null;S.search='';S.view='indoor';toast('Indoor job '+id+' berhasil disimpan.');}
function onSubmitMaster(form){if(!superAdmin())return;let v=formObj(form);let items=db[S.tab],x=S.editId?items.find(t=>t.id===S.editId):null;let name=v.name?.trim();if(!name)return notify('Nama wajib diisi.');if(items.some(t=>t.id!==S.editId&&t.name.toLowerCase()===name.toLowerCase()))return notify('Nama sudah digunakan pada master ini.');if(S.tab==='centers'&&(!v.type||!v.area))return notify('Tipe dan area harus dipilih.');let prefixes={centers:'SC',types:'TY',areas:'AR',purposes:'P',indoorTypes:'IT',models:'MD',sources:'SO'};let id=x?.id||prefixes[S.tab]+String(Math.max(0,...items.map(t=>Number(t.id.replace(/\D/g,''))||0))+1).padStart(3,'0');let rec={id,name,active:v.active==='true'};if(S.tab==='centers')Object.assign(rec,{type:v.type,area:v.area});if(S.tab==='types')rec.description=v.description||'';if(S.tab==='models')rec.category=v.category||'';if(x){if(S.tab==='areas'&&x.name!==name){db.centers.forEach(c=>{if(c.area===x.name)c.area=name});db.users.forEach(u=>{u.areas=u.areas.map(a=>a===x.name?name:a)})}if(S.tab==='types'&&x.name!==name){db.centers.forEach(c=>{if(c.type===x.name)c.type=name})}if(S.tab==='purposes'&&x.name!==name){db.visits.forEach(v=>{if(v.purpose===x.name)v.purpose=name})}if(S.tab==='indoorTypes'&&x.name!==name){db.indoor.forEach(v=>{if(v.type===x.name)v.type=name})}if(S.tab==='models'&&x.name!==name){db.visits.forEach(v=>{if(v.model===x.name)v.model=name});db.indoor.forEach(v=>{if(v.model===x.name)v.model=name})}if(S.tab==='sources'&&x.name!==name){db.visits.forEach(v=>{if(v.source===x.name)v.source=name})}Object.assign(x,rec)}else items.push(rec);save();S.modal=null;S.editId=null;toast('Master data berhasil disimpan.');}
function onSubmitUser(form){if(!superAdmin())return;let v=formObj(form),u=S.editId?db.users.find(x=>x.id===S.editId):null;if(!v.name||!v.email)return notify('Nama dan email wajib.');if(db.users.some(x=>x.email.toLowerCase()===v.email.toLowerCase()&&x.id!==S.editId))return notify('Email sudah dipakai akun lain.');if(v.role==='lead'&&!v.areas.length&&!v.centers.length)return notify('Lead wajib memiliki setidaknya satu area/cabang.');if(v.role==='branch'&&!v.centers.length)return notify('Branch User wajib memiliki cabang.');if(u?.id===current().id&&(v.role!=='super'||v.active!=='true'))return notify('Tidak dapat menonaktifkan atau menurunkan role akun sendiri.');let id=u?.id||'U'+String(Math.max(0,...db.users.map(x=>Number(x.id.replace(/\D/g,''))||0))+1).padStart(3,'0');let rec={id,name:v.name,email:v.email.toLowerCase(),role:v.role,centers:v.role==='super'?[]:v.centers,areas:v.role==='super'?[]:v.areas,active:v.active==='true'};if(u)Object.assign(u,rec);else db.users.push(rec);save();S.modal=null;S.editId=null;toast('Akun berhasil disimpan.');}
function bind(){const root=byId('root');
const suggest=root.querySelector('[data-model-suggest]');if(suggest)suggest.onclick=()=>{S.modal='modelSuggest';render()};
const sg=byId('modelSuggestForm');if(sg)sg.onsubmit=e=>{e.preventDefault();const n=sg.elements.name.value.trim(),cat=sg.elements.category.value.trim();if(!n)return notify('Nama model wajib.');queueModel(n,current().id);let rec=db.modelRequests.find(r=>r.name.toLowerCase()===n.toLowerCase()&&r.status==='Pending');if(rec&&cat)rec.category=cat;save();S.modal=null;toast(db.models.some(m=>m.name.toLowerCase()===n.toLowerCase())?'Model sudah ada di master.':'Usulan model diterima untuk review.');};
root.querySelectorAll('[data-model-approve],[data-model-reject]').forEach(b=>b.onclick=()=>{if(!superAdmin())return;let id=b.dataset.modelApprove||b.dataset.modelReject,r=db.modelRequests.find(x=>x.id===id);if(!r||r.status!=='Pending')return;if(b.hasAttribute('data-model-approve')){if(!db.models.some(m=>m.name.toLowerCase()===r.name.toLowerCase()))db.models.push({id:'MD'+String(Math.max(0,...db.models.map(m=>Number(m.id.replace(/\D/g,''))||0))+1).padStart(3,'0'),name:r.name,category:r.category||'',active:true});r.status='Approved';}else r.status='Rejected';r.reviewedBy=current().id;save();toast('Model request '+r.status+'.');});
root.querySelectorAll('[data-nav]').forEach(b=>b.onclick=()=>{S.view=b.dataset.nav;S.search='';S.editId=null;S.centerFilter='all';S.modal=null;render()});const lf=byId('loginForm');if(lf)lf.onsubmit=e=>{e.preventDefault();let email=lf.elements.email.value.trim().toLowerCase();if(!db.users.some(u=>u.email.toLowerCase()===email&&u.active))return notify('Email tidak ditemukan atau akun nonaktif.');S.pendingEmail=email;S.screen='otp';render()};root.querySelectorAll('[data-demo-email]').forEach(b=>b.onclick=()=>{S.pendingEmail=b.dataset.demoEmail;S.screen='otp';render()});const of=byId('otpForm');if(of)of.onsubmit=e=>{e.preventDefault();if(of.elements.otp.value.trim()!=='123456')return notify('OTP demo tidak sesuai. Gunakan 123456.');const user=db.users.find(u=>u.email.toLowerCase()===S.pendingEmail&&u.active);if(!user)return notify('Akun tidak tersedia.');S.userId=user.id;S.screen='app';S.view='overview';S.centerFilter='all';render()};const back=byId('backLogin');if(back)back.onclick=()=>{S.screen='login';render()};root.querySelectorAll('[data-logout], [data-switch]').forEach(b=>b.onclick=()=>{S.screen='login';S.userId=null;S.search='';S.modal=null;render()});const sf=byId('scopeCenter');if(sf)sf.onchange=()=>{S.centerFilter=sf.value;render()};const search=byId('search');if(search)search.oninput=()=>{let pos=search.selectionStart;S.search=search.value;render();let q=byId('search');if(q){q.focus();q.setSelectionRange(pos,pos)}};const vf=byId('visitForm');if(vf)vf.onsubmit=e=>{e.preventDefault();onSubmitVisit(vf)};const inf=byId('indoorForm');if(inf){let a=inf.elements.centerId,b=inf.elements.visitId;let updateRelated=()=>{let candidates=db.visits.filter(v=>v.centerId===a.value&&canCenter(v.centerId));let old=b.value;b.innerHTML='<option value="">No related visit</option>'+opt(candidates.map(v=>({id:v.id,name:v.id+' · '+v.customer+' · '+v.model})),old);if(!candidates.some(x=>x.id===old))b.value=''};a.onchange=updateRelated;b.onchange=()=>{const v=db.visits.find(x=>x.id===b.value);if(v){['customer','model','ron'].forEach(k=>{if(v[k]&&!inf.elements[k].value)inf.elements[k].value=v[k]})}};inf.onsubmit=e=>{e.preventDefault();onSubmitIndoor(inf)}}root.querySelectorAll('[data-detail]').forEach(b=>b.onclick=()=>{let [type,id]=b.dataset.detail.split(':');S.detailType=type;S.detailId=id;S.modal='detail';render()});root.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>{let [type,id]=b.dataset.edit.split(':');let x=db[type==='visit'?'visits':'indoor'].find(x=>x.id===id);if(!x||!canCenter(x.centerId))return;S.editId=id;S.view=type==='visit'?'visitNew':'indoorNew';S.modal=null;S.search='';render()});root.querySelectorAll('[data-master-tab]').forEach(b=>b.onclick=()=>{S.tab=b.dataset.masterTab;render()});root.querySelectorAll('[data-master-edit]').forEach(b=>b.onclick=()=>{S.editId=b.dataset.masterEdit;S.modal='master';render()});root.querySelectorAll('[data-user-edit]').forEach(b=>b.onclick=()=>{S.editId=b.dataset.userEdit;S.modal='user';render()});const am=root.querySelector('[data-add-master]');if(am)am.onclick=()=>{S.editId=null;S.modal='master';render()};const au=root.querySelector('[data-add-user]');if(au)au.onclick=()=>{S.editId=null;S.modal='user';render()};root.querySelectorAll('[data-ann-edit]').forEach(b=>b.onclick=()=>{if(!superAdmin())return;S.editId=b.dataset.annEdit;S.modal='announcement';render()});const addAnn=root.querySelector('[data-ann-add]');if(addAnn)addAnn.onclick=()=>{if(!superAdmin())return;S.editId=null;S.modal='announcement';render()};const announcementForm=byId('announcementForm');if(announcementForm)announcementForm.onsubmit=e=>{e.preventDefault();onSubmitAnnouncement(announcementForm)};const mf=byId('masterForm');if(mf)mf.onsubmit=e=>{e.preventDefault();onSubmitMaster(mf)};const uf=byId('userForm');if(uf)uf.onsubmit=e=>{e.preventDefault();onSubmitUser(uf)};['closeModal','cancelModal','closeDetail'].forEach(id=>{const n=byId(id);if(n)n.onclick=()=>{S.modal=null;S.editId=null;render()}});const overlay=byId('overlay');if(overlay)overlay.onclick=e=>{if(e.target===overlay){S.modal=null;S.editId=null;render()}};}
render();
})();
</script>
